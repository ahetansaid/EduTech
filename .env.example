# Copier en .env à la racine du dépôt (jamais commité). Valeurs fournies par Neon (région eu-central-1).
# Connexion mutualisée (pooler) — application et scripts
DATABASE_URL=postgresql://UTILISATEUR:MOT_DE_PASSE@ep-xxxx-pooler.eu-central-1.aws.neon.tech/beile?sslmode=require
# Connexion directe — migrations uniquement (rôle propriétaire)
DATABASE_URL_UNPOOLED=postgresql://UTILISATEUR:MOT_DE_PASSE@ep-xxxx.eu-central-1.aws.neon.tech/beile?sslmode=require
# Rôle restreint de l'API (créé par `npm run role-api -w @beile/db`). L'API refuse un superutilisateur ou un rôle BYPASSRLS.
DATABASE_URL_API=postgresql://beile_api:MOT_DE_PASSE_GENERE@ep-xxxx-pooler.eu-central-1.aws.neon.tech/beile?sslmode=require
# Origines autorisées par l'API (CORS). La première fixe aussi le domaine des clés de sécurité (WebAuthn).
BEILE_ORIGINES_AUTORISEES=http://localhost:3000

# Clé du sceau des actes et diplômes (32 caractères minimum), OBLIGATOIRE en production et en prévisualisation.
# Rotation : nouvelle clé ici, ancienne dans BEILE_CLES_SEAU_ANCIENNES (jamais « altéré » à tort).
BEILE_CLE_SEAU=
# BEILE_CLES_SEAU_ANCIENNES=
# Clé maîtresse des secrets dérivés (codes, TOTP, défis). À défaut : la clé du sceau. Ne jamais la changer
# sans rechiffrer les secrets TOTP (sinon tous les seconds facteurs deviennent illisibles).
# BEILE_CLE_MAITRESSE=

# Systèmes partenaires (interopérabilité) : « id:secret » séparés par des virgules, secret de 32 caractères minimum.
# BEILE_PARTENAIRES=educmaster:...,eresultats:...

# Envoi des codes : passerelle SMS d'un opérateur national, SMTP du domaine de la plateforme (SPF, DKIM, DMARC).
# BEILE_SMS_URL=  BEILE_SMS_CLE=  BEILE_SMS_EXPEDITEUR=BEILE
# BEILE_SMTP_URL=smtps://utilisateur:motdepasse@smtp.domaine.bj:465  BEILE_COURRIEL_EXPEDITEUR=ne-pas-repondre@domaine.bj

# Adresse du client : « vercel » (défaut sur Vercel), « mandataire » (derrière nginx : BEILE_MANDATAIRES=1), « socket ».
# BEILE_SOURCE_IP=mandataire
# BEILE_MANDATAIRES=1
# Portail servi : unique | public | usagers | gestion | national (le national exige BEILE_IP_AUTORISEES).
# BEILE_PORTAIL=unique
# BEILE_WEBAUTHN_RP_ID=beile.bj
