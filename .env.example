# Copier en .env à la racine du dépôt (jamais commité). Valeurs fournies par Neon (région eu-central-1).
# Connexion mutualisée (pooler) — application et API
DATABASE_URL=postgresql://UTILISATEUR:MOT_DE_PASSE@ep-xxxx-pooler.eu-central-1.aws.neon.tech/beile?sslmode=require
# Connexion directe — migrations uniquement
DATABASE_URL_UNPOOLED=postgresql://UTILISATEUR:MOT_DE_PASSE@ep-xxxx.eu-central-1.aws.neon.tech/beile?sslmode=require
# Origines autorisées par l'API (CORS)
BEILE_ORIGINES_AUTORISEES=http://localhost:3000
# Rôle restreint de l'API (créé par `npm run role-api -w @beile/db`, mot de passe généré localement)
DATABASE_URL_API=postgresql://beile_api:MOT_DE_PASSE_GENERE@ep-xxxx-pooler.eu-central-1.aws.neon.tech/beile?sslmode=require
# Secret de signature des jetons (48 octets aléatoires minimum)
BEILE_JWT_SECRET=
# Active la connexion par profil de démonstration (jamais en production)
BEILE_MODE_DEMO=true
# Interface web (apps/web/.env.local) : URL de l'API ; absente = mode simulation intégral
# NEXT_PUBLIC_BEILE_API=http://localhost:4000/api/v1
